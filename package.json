{
  "name": "jjangditer",
  "productName": "JJangditer",
  "version": "1.3.2",
  "description": "짱디터 - 서버 설치 체크리스트용 우측 도킹 사이드 에디터 (WebView2)",
  "author": "Jjangs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "node tools/build.js",
    "icon": "python tools/make-icon.py",
    "template": "node tools/export-template.js",
    "release": "node tools/publish.js"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jjangs.jjangditer",
    "productName": "JJangditer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.ico"
    ],
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "compression": "maximum",
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "짱디터-${version}.exe",
      "unpackDirName": "jjangditer"
    }
  }
}
